<?xml version="1.0"?>
<robot name="shit_arm_so101_like">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.04"/></geometry>
      <material name="base"><color rgba="0.18 0.22 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 0.04"/></geometry>
      <material name="joint"><color rgba="0.10 0.14 0.20 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.22"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0.09 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="0.18"/></geometry>
      <material name="arm"><color rgba="0.38 0.84 0.66 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.09 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="0.18"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.09 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0.08 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.022" length="0.16"/></geometry>
      <material name="arm"/>
    </visual>
    <collision>
      <origin xyz="0 0.08 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.022" length="0.16"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.08 0" rpy="0 0 0"/>
      <mass value="0.14"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <link name="wrist_roll_link">
    <visual>
      <origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.10"/></geometry>
      <material name="wrist"><color rgba="0.30 0.42 0.62 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.05 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <link name="wrist_pitch_link">
    <visual>
      <origin xyz="0 0.0375 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.018" length="0.075"/></geometry>
      <material name="wrist"/>
    </visual>
    <collision>
      <origin xyz="0 0.0375 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.018" length="0.075"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0375 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00012"/>
    </inertial>
  </link>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0.0275 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.055 0.035"/></geometry>
      <material name="gripper"><color rgba="0.95 0.79 0.41 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.0275 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.055 0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0275 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0.027 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.054 0.018"/></geometry>
      <material name="gripper"/>
    </visual>
    <collision>
      <origin xyz="0 0.027 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.054 0.018"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.027 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0.027 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.054 0.018"/></geometry>
      <material name="gripper"/>
    </visual>
    <collision>
      <origin xyz="0 0.027 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.054 0.018"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.027 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="4.0" velocity="4.0"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.4" upper="2.4" effort="4.0" velocity="4.0"/>
  </joint>

  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0.18 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.6" upper="2.6" effort="4.0" velocity="4.0"/>
  </joint>

  <joint name="wrist_roll" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0.16 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="2.0" velocity="4.0"/>
  </joint>

  <joint name="wrist_pitch" type="revolute">
    <parent link="wrist_roll_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0.10 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.4" upper="2.4" effort="2.0" velocity="4.0"/>
  </joint>

  <joint name="wrist_yaw" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0.075 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="2.0" velocity="4.0"/>
  </joint>

  <joint name="left_finger" type="prismatic">
    <parent link="gripper_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.018 0.055 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.04" effort="1.0" velocity="0.2"/>
  </joint>

  <joint name="right_finger" type="prismatic">
    <parent link="gripper_link"/>
    <child link="right_finger_link"/>
    <origin xyz="-0.018 0.055 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.04" effort="1.0" velocity="0.2"/>
  </joint>
</robot>
